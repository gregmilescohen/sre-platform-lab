{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "API Golden Signals",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(pulseboard_api_requests_total[5m]))", "legendFormat": "req/s", "refId": "A" }],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "max": 1, "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "targets": [{
        "expr": "(sum(rate(pulseboard_api_requests_total{status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(pulseboard_api_requests_total[5m]))",
        "legendFormat": "error rate", "refId": "A"
      }],
      "title": "Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "max": 1, "min": 0.9,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "targets": [{ "expr": "job:pulseboard_api_availability:ratio_rate5m", "legendFormat": "availability (5m)", "refId": "A" }],
      "title": "Availability SLI",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.3 }, { "color": "red", "value": 0.5 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "targets": [
        { "expr": "job:pulseboard_api_latency_p95:rate5m", "legendFormat": "p95", "refId": "A" },
        { "expr": "job:pulseboard_api_latency_p99:rate5m", "legendFormat": "p99", "refId": "B" }
      ],
      "title": "Latency (p95 / p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 20,
      "title": "Pub/Sub",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 10 },
      "id": 21,
      "targets": [{
        "expr": "sum(rate(pulseboard_api_requests_total{method=\"POST\",endpoint=\"/events/\",status_code=\"200\"}[1m]))",
        "legendFormat": "events published/s", "refId": "A"
      }],
      "title": "Publish Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 22,
      "targets": [{
        "expr": "rate(pulseboard_consumer_messages_processed_total[1m])",
        "legendFormat": "messages processed/s", "refId": "A"
      }],
      "title": "Consumer Processing Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 23,
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(pulseboard_consumer_processing_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 batch duration", "refId": "A"
      }],
      "title": "Consumer Batch Duration (p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 10 },
      "id": 24,
      "targets": [{
        "expr": "pulseboard_consumer_subscription_backlog_messages",
        "legendFormat": "backlog", "refId": "A"
      }],
      "title": "Subscription Backlog (approx)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 30,
      "title": "Logs",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 31,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service=\"pulseboard-api\"}", "refId": "A" }],
      "title": "pulseboard-api logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 32,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service=\"pulseboard-consumer\"}", "refId": "A" }],
      "title": "pulseboard-consumer logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 33,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service=\"pulseboard-worker\"}", "refId": "A" }],
      "title": "pulseboard-worker logs",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 34,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service=\"sre-agent\"}", "refId": "A" }],
      "title": "sre-agent logs",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "id": 40,
      "title": "Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 36 },
      "id": 41,
      "targets": [{ "queryType": "serviceMap", "refId": "A" }],
      "title": "Service Map",
      "type": "nodeGraph"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 36 },
      "id": 42,
      "targets": [{
        "limit": 20,
        "query": "{resource.service.name=\"pulseboard-api\"}",
        "queryType": "traceqlSearch",
        "tableType": "traces",
        "refId": "A"
      }],
      "title": "Recent Traces — pulseboard-api",
      "type": "traces"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 },
      "id": 43,
      "targets": [{
        "limit": 20,
        "query": "{resource.service.name=\"pulseboard-api\" && status=error}",
        "queryType": "traceqlSearch",
        "tableType": "traces",
        "refId": "A"
      }],
      "title": "Error Traces (zero rows = healthy)",
      "type": "traces"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["pulseboard"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "PulseBoard Overview",
  "uid": "pulseboard-overview",
  "version": 1
}
