{
  "mcp": {
    "grafana": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-grafana"],
      "env": {
        "GRAFANA_URL": "http://grafana:3000",
        "GRAFANA_API_KEY": ""
      }
    },
    "alertmanager": {
      "type": "local",
      "command": "uvx",
      "args": ["alertmanager-mcp-server"],
      "env": {
        "ALERTMANAGER_URL": "http://alertmanager:9093"
      }
    }
  }
}
